{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ADR-015 슬랙 에이전트 팀. 운영 API(offside-api)와 배포 · 저장소를 나눈다(운영 D1 바인딩 없음).
  "name": "offside-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "routes": [{ "pattern": "agents.offside-lab.com", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "AgentThread" },
      { "name": "LEDGER", "class_name": "AgentLedger" },
      // T-11-325 작업 카드(스레드마다 하나, card.ts).
      { "name": "CARD", "class_name": "WorkCard" },
    ],
  },
  "migrations": [
    { "tag": "v1-agents", "new_sqlite_classes": ["AgentThread", "AgentLedger"] },
    { "tag": "v2-cards", "new_sqlite_classes": ["WorkCard"] },
  ],
  // 매시 7분 고객 문의 메일(@plan, support.ts, T-11-291). 3시간마다 47분 유저 반응 살피기(@plan, reactions.ts, 디시는 매시 27분 Actions가 넣어 둔 것, T-11-289),
  // 매일 23:50 UTC(08:50 KST) 주기 작업 보고(@ops) · 열린 카드 목록(@plan) · 월요일 주간 회고(@plan) · 주간 유입 리포트(@mkt).
  // T-11-325: 5분마다 서버 상태 감시(@ops, watch.ts), 01:00 · 09:00 UTC(10:00 · 18:00 KST) 승인 대기 묶음(@plan).
  "triggers": {
    "crons": ["47 */3 * * *", "7 * * * *", "50 23 * * *", "*/5 * * * *", "0 1,9 * * *"],
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": {
    // ADR-015 도입 단계: 4단계(T-11-296)에 @mkt까지 연다.
    "ENABLED_ROLES": "ops,plan,dev,mkt",
    // T-11-299 @mkt GA4 읽기(OFFSIDE - Production 속성, 서비스 계정은 뷰어). 비공개 키 · 계정 메일은 비밀값 GA4_SA_KEY · GA4_SA_EMAIL.
    "GA4_PROPERTY_ID": "556515567",
    "GA4_KEY_ID": "0de7dab176e5ac1a7a2d413b993a0d760a5fc717",
    "OPERATOR_USER_ID": "U0C9BAYGT8Q",
    // 에이전트 봇 4개(자기 · 서로의 메시지에 반응하지 않는다).
    "AGENT_APP_IDS": "A0C987NV8HZ,A0C9CFUM98E,A0C996C6R3P,A0C9E9PELTC",
    "AGENT_BOT_USERS": "U0C987SP9MH,U0C9J5P80JG,U0C996EN269,U0C8Z49E58F",
    // #offside-alerts
    "ALERT_CHANNELS": "C0C8FEU657G",
    "CF_ACCOUNT_ID": "12f369468d8f8386e116a5c76da455d2",
    "D1_DATABASE_ID": "2cfe462c-204e-4842-805c-5840fc9b1758",
    "GITHUB_REPO": "tasddc1226/offside-football-simulator",
    "API_BASE": "https://api.offside-lab.com",
    // #agent-desk
    "DESK_CHANNEL": "C0C9E9WRVA6",
    "TASK_BUDGET_USD": "1.5",
    "DAILY_BUDGET_USD": "5",
    "DAILY_BUDGET_DEV_USD": "20",
    "DEV_RUN_BUDGET_USD": "5",
    "APPROVAL_CHANNEL": "C0C9GCJPYAV",
    // 고객 문의 메일함 검색 조건(T-11-291).
    "SUPPORT_QUERY": "to:contact@offside-lab.com",
    // Gmail 보내기 별칭(Cloudflare SMTP로 나간다, DKIM 자동).
    "SUPPORT_FROM": "오프사이드 <contact@offside-lab.com>",
    "GITHUB_APP_ID": "5332532",
    "GITHUB_APP_INSTALLATION_ID": "171765849",
  },
}
