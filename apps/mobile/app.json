{
  "expo": {
    "name": "오프사이드",
    "slug": "offside",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offside",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d1511",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bacad4c8-df2f-4fc5-8938-b02d060fbc45"
    },
    "ios": {
      "bundleIdentifier": "com.offsidelab.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleName": "오프사이드"
      }
    },
    "android": {
      "package": "com.offsidelab.app",
      "adaptiveIcon": {
        "backgroundColor": "#1c4a35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c4a35",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bacad4c8-df2f-4fc5-8938-b02d060fbc45"
      }
    },
    "owner": "tasddc1569"
  }
}
