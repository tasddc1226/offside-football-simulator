{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.offside-lab.com",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://offside-lab.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6817463687" },
      "android": { "track": "alpha", "releaseStatus": "draft" }
    }
  }
}
