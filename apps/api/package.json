{
  "name": "@offside/api",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:query": "wrangler d1 execute offside-local --local --command",
    "db:query:staging": "wrangler d1 execute offside-staging --remote --env staging --command",
    "db:query:production": "wrangler d1 execute offside-production --remote --env production --command",
    "db:migrate": "wrangler d1 migrations apply offside-local --local",
    "db:migrate:staging": "wrangler d1 migrations apply offside-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply offside-production --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:check": "drizzle-kit generate && test -z \"$(git status --porcelain -- migrations)\""
  },
  "dependencies": {
    "@offside/contracts": "workspace:*",
    "arctic": "3.7.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "@offside/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "miniflare": "5.20260828.0-alpha",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
