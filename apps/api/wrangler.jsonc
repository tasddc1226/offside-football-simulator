{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offside-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "offside-local",
      // 원격 ID는 배포 환경의 env.staging/production에만 둔다.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // T-10-070 로컬(테스트·wrangler dev)은 Miniflare가 흉내 내는 R2. 운영 버킷은 env.production에만 둔다.
  "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "offside-backup-local" }],
  // T-10-072 홈 라이브 실시간 허브(src/live/hub.ts), T-11-015 채팅방(src/chat/room.ts). 바인딩은 환경마다 다시
  // 적어야 한다(상속되지 않는다).
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "LiveHub" },
      { "name": "CHAT", "class_name": "ChatRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1-live-hub", "new_sqlite_classes": ["LiveHub"] },
    { "tag": "v2-chat-room", "new_sqlite_classes": ["ChatRoom"] },
  ],
  // 로컬 기본값. 원격 origin은 staging/production 환경에만 둔다. 비밀값 없음.
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    // D-21. GOOGLE_CLIENT_ID·GOOGLE_CLIENT_SECRET은 U-003 뒤 `wrangler secret put`으로 넣는다.
    // GOOGLE_FAKE=1은 로컬에서만 의미가 있다(가짜 OIDC).
    "WEB_APP_URL": "http://localhost:5173",
    "GOOGLE_REDIRECT_URI": "http://localhost:8787/v1/auth/google/callback",
    "GOOGLE_FAKE": "1",
    // T-11-003 APPLE_FAKE=1이면 로컬에서 'fake:<sub>' 신원 토큰을 받는다(실제 Apple 검증 없이).
    "APPLE_FAKE": "1",
  },
  "env": {
    "staging": {
      "name": "offside-api-staging",
      // T-11-146 공지 번역 초안·댓글·채팅 번역 보기(src/translate). 로컬·테스트엔 두지 않는다(원격 호출) — 없으면 번역만 503.
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "LIVE", "class_name": "LiveHub" },
          { "name": "CHAT", "class_name": "ChatRoom" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "offside-staging",
          "database_id": "37688e3f-b905-4240-abdb-e23e778dfad9",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "PUSH_TEST_ENABLED": "1",
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://offside-web-staging.tasddc1569.workers.dev",
        "WEB_APP_URL": "https://offside-web-staging.tasddc1569.workers.dev",
        "GOOGLE_REDIRECT_URI": "https://offside-api-staging.tasddc1569.workers.dev/v1/auth/google/callback",
        "GOOGLE_FAKE": "0",
        "APPLE_FAKE": "0",
      },
    },
    "production": {
      "name": "offside-api",
      "workers_dev": true,
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "api.offside-lab.com", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 },
      },
      // T-10-070 매일 KST 04:00 정리·D1 백업(src/cron/daily.ts).
      "triggers": { "crons": ["0 19 * * *", "*/5 * * * *"] },
      // T-10-071 백업 사본(docs/operations/d1-backup.md).
      "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "offside-d1-backup" }],
      "durable_objects": {
        "bindings": [
          { "name": "LIVE", "class_name": "LiveHub" },
          { "name": "CHAT", "class_name": "ChatRoom" },
        ],
      },
      // 백업은 DB 전체를 SQL로 굽고 압축한다 — DB가 커져도 중간에 끊기지 않게 CPU 한도를 기본(30초)보다 늘린다.
      "limits": { "cpu_ms": 120000 },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "offside-production",
          "database_id": "2cfe462c-204e-4842-805c-5840fc9b1758",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "NEWS_PUSH_ENABLED": "1",
        "PUSH_TEST_ENABLED": "1",
        "PERSONAL_PUSH_ENABLED": "1",
        "REENGAGEMENT_PUSH_ENABLED": "1",
        "ALLOWED_ORIGINS": "https://offside-lab.com,https://offside-web.tasddc1569.workers.dev",
        "WEB_APP_URL": "https://offside-web.tasddc1569.workers.dev",
        "GOOGLE_REDIRECT_URI": "https://offside-api.tasddc1569.workers.dev/v1/auth/google/callback",
        "GOOGLE_FAKE": "0",
        "APPLE_FAKE": "0",
        // T-11-202 웹 Sign in with Apple Services ID(개인 팀 WK93KW2348, 돌아올 주소는 api.offside-lab.com · workers.dev 두 곳).
        "APPLE_WEB_CLIENT_ID": "com.offsidelab.web",
      },
    },
  },
}
