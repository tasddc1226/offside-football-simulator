{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offside-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "offside-local",
      // 원격 ID는 배포 환경의 env.staging/production에만 둔다.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // T-10-070 로컬(테스트·wrangler dev)은 Miniflare가 흉내 내는 R2. 운영 버킷은 env.production에만 둔다.
  "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "offside-backup-local" }],
  // 로컬 기본값. 원격 origin은 staging/production 환경에만 둔다. 비밀값 없음.
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    // D-21. GOOGLE_CLIENT_ID·GOOGLE_CLIENT_SECRET은 U-003 뒤 `wrangler secret put`으로 넣는다.
    // GOOGLE_FAKE=1은 로컬에서만 의미가 있다(가짜 OIDC).
    "WEB_APP_URL": "http://localhost:5173",
    "GOOGLE_REDIRECT_URI": "http://localhost:8787/v1/auth/google/callback",
    "GOOGLE_FAKE": "1",
  },
  "env": {
    "staging": {
      "name": "offside-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "offside-staging",
          "database_id": "37688e3f-b905-4240-abdb-e23e778dfad9",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://offside-web-staging.tasddc1569.workers.dev",
        "WEB_APP_URL": "https://offside-web-staging.tasddc1569.workers.dev",
        "GOOGLE_REDIRECT_URI": "https://offside-api-staging.tasddc1569.workers.dev/v1/auth/google/callback",
        "GOOGLE_FAKE": "0",
      },
    },
    "production": {
      "name": "offside-api",
      "workers_dev": true,
      "routes": [{ "pattern": "api.offside-lab.com", "custom_domain": true }],
      // T-10-070 매일 KST 04:00 정리·D1 백업(src/cron/daily.ts). R2 버킷(BACKUP)을 붙이면 백업도 돈다.
      "triggers": { "crons": ["0 19 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "offside-production",
          "database_id": "2cfe462c-204e-4842-805c-5840fc9b1758",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://offside-lab.com,https://offside-web.tasddc1569.workers.dev",
        "WEB_APP_URL": "https://offside-web.tasddc1569.workers.dev",
        "GOOGLE_REDIRECT_URI": "https://offside-api.tasddc1569.workers.dev/v1/auth/google/callback",
        "GOOGLE_FAKE": "0",
      },
    },
  },
}
